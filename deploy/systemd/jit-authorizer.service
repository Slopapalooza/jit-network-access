[Unit]
Description=JIT Network Access Authorizer
Documentation=https://github.com/Slopapalooza/jit-network-access
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=jitaccess
Group=jitaccess
ExecStart=/usr/local/bin/jitaccess-authorizer -config /etc/jitaccess/config.json
# SIGHUP swaps the token registry and services without dropping live grants, so
# `systemctl reload jit-authorizer` after editing config.json is not a restart
# and nobody gets locked out mid-session.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2

# --- hardening -------------------------------------------------------------
#
# This process holds every device secret for every gated service in memory and
# reads them from disk at startup. It needs: one listening socket, one config
# file, and nothing else whatsoever. The sandbox says exactly that.
#
# No capabilities at all — the default port is 8998, above 1024, so binding
# needs none. If you move `listen` below 1024, do NOT add CAP_NET_BIND_SERVICE
# here; put a reverse proxy in front, which is the deployment shape anyway.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectProc=invisible
ProcSubset=pid
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Only IP sockets. No unix, no netlink, no packet sockets.
RestrictAddressFamilies=AF_INET AF_INET6

# The config carries secrets; anything this process creates should not be
# world-readable either.
UMask=0077

[Install]
WantedBy=multi-user.target
