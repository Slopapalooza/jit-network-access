# Python
__pycache__/
*.pyc
.venv/
venv/

# Node / extension
node_modules/
# Build output. Release artifacts are ATTACHED to a GitHub release, not
# committed: a .crx in git history is a binary nobody can review in a diff, and
# it goes stale the moment the source moves.
extension/dist/
*.zip
*.crx
*.pem

# Go
/authorizer/bin/
*.exe

# Build output / vendored copies (regenerated by build scripts)
adapters/bunkerweb/jitaccess/core/*.lua
adapters/bunkerweb/jitaccess.tar.gz
test/harness/plugins/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Local secrets / test data that should never be committed
*.key
*.pem
*.local.json
bw-data/

# Local-only working docs (not published)
SECURITY-REVIEW.md
docs/*-debug-*.md
HANDOFF.md

# Go
core/go/*.exe
authorizer/jitaccess-authorizer
authorizer/*.exe
authorizer/config.json
adapters/caddy/caddy-jit
adapters/caddy/cmd/caddy-jit/caddy-jit
